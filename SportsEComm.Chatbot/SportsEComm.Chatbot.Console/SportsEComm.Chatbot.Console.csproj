<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SportsEComm.Chatbot.Console</RootNamespace>
    <AssemblyName>SportsEComm.Chatbot.Console</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.0" />
  </ItemGroup>

  <!-- Orchestration classes (ModelClient, McpClient, ConversationManager, PromptTemplates)
       live in SportsEComm.Chatbot.Common — referenced via ProjectReference below. -->

  <ItemGroup>
    <!-- Copy parent appsettings.json to output -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SportsEComm.Chatbot.Common\SportsEComm.Chatbot.Common.csproj" />
  </ItemGroup>
</Project>
