<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SportsEComm.Chatbot.Common</RootNamespace>
    <!-- Prevent intermediate output collisions when multiple projects are in the same folder by isolating obj for this project -->
    <IntermediateOutputPath>obj\Common\</IntermediateOutputPath>
  </PropertyGroup>
</Project>
